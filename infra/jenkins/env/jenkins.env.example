# Copy to env/jenkins.env — never commit secrets.

# Jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://localhost:8080/
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme
# Dev: 2 executors on controller. Prod: 0 on controller; schedule builds on labeled agents.
JENKINS_NUM_EXECUTORS=2
# Dev: omit (Jenkinsfile defaults to any). Prod: label on dedicated build agents.
# JENKINS_AGENT_LABEL=linux docker maven node22

GIT_REPO_URL=https://github.com/your-org/open-crm-cpq.git
SCM_TOKEN=

# AI CI assist (ADR-003) — advisory by default
AI_CI_ENABLED=false
AI_CI_BLOCKING=false

# LLM gateway (Azure OpenAI or corporate OpenAI-compatible APIM)
# Do NOT set to http://ai-service:8086 — that is CPQ AgentRouter, not chat completions.
LLM_PROVIDER=azure
LLM_API_KEY=
LLM_ENDPOINT=https://your-resource.openai.azure.com
LLM_MODEL=gpt-4o
LLM_TIMEOUT_MS=120000
LLM_API_VERSION=2024-02-15-preview

# Sidecar overlay only (postgres/redis for ai-service health dependency — not LLM for ai-assist)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Testcontainers (Docker Desktop Mac/Win — uncomment if needed)
# TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal
