{
  "mcpServers": {
    "autojev": {
      "type": "http",
      "url": "https://autojev.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${AUTOJEV_API_KEY}"
      }
    },
    "hindsight": {
      "type": "http",
      "url": "http://localhost:8888/mcp/open-crm-cpq"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.86"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.14.0"
      ]
    }
  }
}
