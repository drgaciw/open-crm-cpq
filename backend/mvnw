# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.4
# ----------------------------------------------------------------------------

# OS specific support. $var _must_ be set to either true or false.
cygwin=false;
darwin=false;
mingw=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true;;
  Darwin*) darwin=true
    # Use /usr/libexec/java_home if available, otherwise fall back
    if [ -z "$JAVA_HOME" ]; then
      if [ -x "/usr/libexec/java_home" ]; then
        JAVA_HOME="$(/usr/libexec/java_home)"; export JAVA_HOME
      fi
    fi
    ;;
esac

if [ -z "$JAVA_HOME" ] ; then
  JAVACMD="$(\\unset -f command 2>/dev/null; \\command -v java)"
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is not defined correctly." >&2
  echo "  We cannot execute $JAVACMD" >&2
  exit 1
fi

find_maven_basedir() {
  if [ -z "$1" ] ; then
    echo "Path not specified to find_maven_basedir"
    return 1
  fi

  basedir="$1"
  wdir="$1"
  while [ "$wdir" != '/' ] ; do
    if [ -d "$wdir"/.mvn ] ; then
      basedir=$wdir
      break
    fi
    if [ -d "${wdir}" ]; then
      wdir=$(cd "$wdir/.." || exit 1; pwd)
    fi
  done
  printf '%s' "$(cd "$basedir" || exit 1; pwd)"
}

concat_lines() {
  if [ -f "$1" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      printf '%s ' "$line"
    done < "$1"
  fi
}

BASE_DIR=$(find_maven_basedir "$(dirname "$0")")
if [ -z "$BASE_DIR" ]; then
  exit 1;
fi

MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$BASE_DIR"}; export MAVEN_PROJECTBASEDIR

if [ -r "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config" ]; then
  JVM_CONFIG_MAVEN_PROPS=$(concat_lines "$MAVEN_PROJECTBASEDIR/.mvn/jvm.config")
fi

wrapperJarPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
wrapperUrl=$(sed -n 's/^wrapperUrl=//p' "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties" 2>/dev/null)
if [ -z "$wrapperUrl" ]; then
  wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
fi

if [ ! -e "$wrapperJarPath" ]; then
  if command -v wget > /dev/null 2>&1; then
    if [ "$MVNW_VERBOSE" = true ]; then
      echo "Downloading $wrapperUrl"
    fi
    wget ${MVNW_USERNAME:+--http-user="$MVNW_USERNAME"} ${MVNW_PASSWORD:+--http-password="$MVNW_PASSWORD"} -O "$wrapperJarPath" "$wrapperUrl" || rm -f "$wrapperJarPath"
  elif command -v curl > /dev/null 2>&1; then
    if [ "$MVNW_VERBOSE" = true ]; then
      echo "Downloading $wrapperUrl"
    fi
    curl -o "$wrapperJarPath" ${MVNW_USERNAME:+-u "$MVNW_USERNAME:$MVNW_PASSWORD"} -fSL "$wrapperUrl" || rm -f "$wrapperJarPath"
  else
    echo "Cannot download maven-wrapper.jar: wget or curl not found"
    exit 1
  fi
fi

# shellcheck disable=SC2086
exec "$JAVACMD" \
  $JVM_CONFIG_MAVEN_PROPS \
  $MAVEN_OPTS \
  $MAVEN_DEBUG_OPTS \
  -classpath "$wrapperJarPath" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  org.apache.maven.wrapper.MavenWrapperMain \
  $MAVEN_CONFIG "$@"
