POSTGRES_USER=opencrm
POSTGRES_PASSWORD=changeme
PGADMIN_DEFAULT_EMAIL=admin@opencrm.local
PGADMIN_DEFAULT_PASSWORD=admin

# Optional AI profile: docker compose --profile ai up -d
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENCRM_AI_AGENTS_ENABLED=false
# ADR-014 live evaluation requires an explicit provider allowlist and spend cap.
OPENROUTER_API_KEY=

# Event path (ADR-010/ADR-018): docker compose --profile events up -d adds Kafka and the four consumer services.
# The outbox relay is opt-in; enabling it replays any unpublished outbox backlog in the producer schemas.
OPENCRM_OUTBOX_RELAY_ENABLED=false
# ADR-018 D8 dual run: crm-service also takes quote acceptance from Kafka (enable with the relay above).
CRM_QUOTE_ACCEPTED_KAFKA_ENABLED=false
