<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.opencrm</groupId>
        <artifactId>open-crm-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>audit</artifactId>
    <name>Audit Library</name>
    <description>Append-only, hash-chained audit trail (DRG-309): AuditEntry entity, append-only repository,
        AuditTrailService and SearchAuditTrail query support. Ships as a Spring Boot auto-configuration so a
        consuming service only needs this dependency on its classpath, plus its own Flyway migration for the
        audit_entries table (libs do not own schema/Flyway; see V20__audit_entries.sql in crm-service).</description>

    <!-- Library jar, not a bootable application -->
    <packaging>jar</packaging>

    <dependencies>
        <!-- Internal -->
        <dependency>
            <groupId>com.opencrm</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- JPA for AuditEntry + AuditEntryRepository; Spring Boot autoconfigure annotations
             (@AutoConfiguration, @EntityScan, @EnableJpaRepositories) for the library's own
             self-contained wiring (ADR-016-style auto-configuration, matching libs/security). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- MapStruct (entity -> DTO at the boundary this library hands back to callers) -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Do NOT package as Spring Boot fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
