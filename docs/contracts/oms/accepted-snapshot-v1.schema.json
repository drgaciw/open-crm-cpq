{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencrm:oms:accepted-snapshot:v1",
  "type": "object",
  "required": [
    "snapshotId",
    "quoteId",
    "quoteNumber",
    "scopeId",
    "customerId",
    "subtotal",
    "discount",
    "tax",
    "total",
    "address",
    "approvalReference",
    "taxEvidence",
    "configurationReference",
    "schemaVersion",
    "acceptedRevision",
    "acceptedAt",
    "currency",
    "lines"
  ],
  "properties": {
    "snapshotId": {
      "type": "string"
    },
    "quoteId": {
      "type": "string"
    },
    "quoteNumber": {
      "type": "string"
    },
    "scopeId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "subtotal": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "discount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "tax": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "total": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "approvalReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "taxEvidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "configurationReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "acceptedRevision": {
      "type": "integer",
      "minimum": 1
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "const": "USD"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "sourceLineId",
          "productId",
          "description",
          "uom",
          "unitPrice",
          "discount",
          "tax",
          "total",
          "fulfillmentType",
          "chargeType",
          "quantity",
          "billingFrequency",
          "startDate",
          "endDate"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "uom": {
            "type": "string"
          },
          "unitPrice": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "discount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "tax": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "total": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "fulfillmentType": {
            "enum": [
              "PHYSICAL",
              "DIGITAL",
              "SERVICE"
            ]
          },
          "chargeType": {
            "enum": [
              "ONE_TIME",
              "RECURRING"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "billingFrequency": {
            "enum": [
              "ONE_TIME",
              "MONTHLY",
              "ANNUAL"
            ]
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    }
  }
}
