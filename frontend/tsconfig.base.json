{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@frontend/shared-models": ["libs/shared/models/src/index.ts"],
      "@frontend/shared-data-access": ["libs/shared/data-access/src/index.ts"],
      "@frontend/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@frontend/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@frontend/crm-contacts": ["libs/crm/contacts/src/index.ts"],
      "@frontend/crm-organizations": ["libs/crm/organizations/src/index.ts"],
      "@frontend/crm-leads": ["libs/crm/leads/src/index.ts"],
      "@frontend/crm-deals": ["libs/crm/deals/src/index.ts"],
      "@frontend/crm-dashboard": ["libs/crm/dashboard/src/index.ts"],
      "@frontend/cpq-catalog": ["libs/cpq/catalog/src/index.ts"],
      "@frontend/cpq-quotes": ["libs/cpq/quotes/src/index.ts"],
      "@frontend/cpq-approvals": ["libs/cpq/approvals/src/index.ts"],
      "@frontend/cpq-price-books": ["libs/cpq/price-books/src/index.ts"],
      "@frontend/cpq-pricing-customers": ["libs/cpq/pricing-customers/src/index.ts"],
      "@frontend/cpq-rule-sets": ["libs/cpq/rule-sets/src/index.ts"],
      "@frontend/cpq-product-bundles": ["libs/cpq/product-bundles/src/index.ts"],
      "@frontend/cpq-pricing-data-access": ["libs/cpq/pricing-data-access/src/index.ts"],
      "@frontend/cpq-pricing-ui": ["libs/cpq/pricing-ui/src/index.ts"],
      "@frontend/cpq-pricing-simulator": ["libs/cpq/pricing-simulator/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
